# Copy to .env and change what you need. Every setting the service reads is listed here.
# Values shown are the defaults used when a setting is left out.

APP_NAME=AssetDesk
APP_VERSION=1.0.0
# development | test | production  (production refuses to start with the default SECRET_KEY)
APP_ENV=development

# SQLite by default. For PostgreSQL: postgresql+psycopg://user:password@host:5432/assetdesk
DATABASE_URL=sqlite:///./assetdesk.db

# Signing key for tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Sign-in accounts created by "python -m app.init_db" if they don't exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
STAFF_USERNAME=staff
STAFF_PASSWORD=change-me-staff

# External system stubs
NOTIFIER_DELAY_SECONDS=0.5
WARRANTY_DELAY_SECONDS=0.5
WARRANTY_TIMEOUT_SECONDS=3.0
