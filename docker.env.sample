# Settings for "docker run --env-file docker.env". Copy to docker.env (git-ignored) and fill in.
# DATABASE_URL and APP_ENV are already set in the image (sqlite in the /data volume, production).

# Left empty on purpose: the container refuses to start until a real key is set.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
# Also empty on purpose: production needs 12+ characters, and not the dev defaults
ADMIN_PASSWORD=
STAFF_USERNAME=staff
STAFF_PASSWORD=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
